# ----------------------------------------------------
# 1. ACTIVE ROUTING (Switch providers here)
# ----------------------------------------------------
# Options typically include: gemini, openai, anthropic
ACTIVE_LLM_PROVIDER=gemini
ACTIVE_EMBEDDING_PROVIDER=gemini

# ----------------------------------------------------
# 2. PROVIDER CONFIGURATIONS
# ----------------------------------------------------

# --- PUBMED ---
# Required by NCBI to track API usage
PUBMED_EMAIL=your_email@example.com

# --- GEMINI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=your_preferred_gemini_model_here
GEMINI_EMBEDDING_MODEL=your_preferred_embedding_model_here

# --- OPENAI ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_LLM_MODEL=your_preferred_openai_model_here
OPENAI_EMBEDDING_MODEL=your_preferred_embedding_model_here

# --- ANTHROPIC ---
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_LLM_MODEL=your_preferred_anthropic_model_here
